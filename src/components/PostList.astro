---
import { getCollection } from 'astro:content';
import { CardGrid } from '@prosefly/astro-components';
import { categories, categoryBySlug, type CategorySlug } from '../lib/categories';
import PostCard from './PostCard.astro';

interface Props {
  /** Group cards into funnel stages. Listings stay in editorial order when false. */
  grouped?: boolean;
}

const { grouped = false } = Astro.props;

const posts = (await getCollection('docs'))
  .filter((entry) => {
    if (entry.data.draft && import.meta.env.PROD) return false;
    const id = entry.id.replace(/\\/g, '/');
    return id.startsWith('posts/') && id !== 'posts/index';
  })
  .sort((a, b) => {
    const orderA = a.data.sidebar?.order ?? a.data.order ?? Number.POSITIVE_INFINITY;
    const orderB = b.data.sidebar?.order ?? b.data.order ?? Number.POSITIVE_INFINITY;
    if (orderA !== orderB) return orderA - orderB;
    return a.data.title.localeCompare(b.data.title);
  });

function hrefFor(id: string) {
  return `/${id.replace(/\\/g, '/')}/`;
}

const groups = categories
  .map((category) => ({
    ...category,
    posts: posts.filter((post) => post.data.category === category.slug),
  }))
  .filter((group) => group.posts.length > 0);

const uncategorized = posts.filter(
  (post) => !categoryBySlug(post.data.category as CategorySlug | undefined),
);
---

{
  posts.length > 0 ? (
    grouped ? (
      <div class="vt-post-groups">
        {groups.length > 0 && (
          <nav class="vt-stage-nav" aria-label="Post stages">
            {groups.map((category) => (
              <a href={`#${category.slug}`}>{category.label}</a>
            ))}
          </nav>
        )}
        {groups.map((group) => (
          <section class="vt-post-group" id={group.slug}>
            <h2 class="vt-post-group__title">{group.label}</h2>
            <p class="vt-post-group__blurb">{group.blurb}</p>
            <CardGrid>
              {group.posts.map((post) => (
                <PostCard
                  href={hrefFor(post.id)}
                  kicker={group.label}
                  title={post.data.title}
                  summary={post.data.description}
                  cover={post.data.cover}
                />
              ))}
            </CardGrid>
          </section>
        ))}
        {uncategorized.length > 0 && (
          <section class="vt-post-group" id="uncategorized">
            <h2 class="vt-post-group__title">Uncategorized</h2>
            <CardGrid>
              {uncategorized.map((post) => (
                <PostCard
                  href={hrefFor(post.id)}
                  title={post.data.title}
                  summary={post.data.description}
                  cover={post.data.cover}
                />
              ))}
            </CardGrid>
          </section>
        )}
      </div>
    ) : (
      <CardGrid>
        {posts.map((post) => {
          const category = categoryBySlug(post.data.category);
          return (
            <PostCard
              href={hrefFor(post.id)}
              kicker={category?.label}
              title={post.data.title}
              summary={post.data.description}
              cover={post.data.cover}
            />
          );
        })}
      </CardGrid>
    )
  ) : (
    <p>No posts yet. Add an MDX file under <code>src/content/docs/posts/</code>.</p>
  )
}
